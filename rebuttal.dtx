    \pdfstringdefDisableCommands{%
      \let\addition\rebuttal@addition@protect
      \let\deletion\rebuttal@deletion@protect
      \let\change\rebuttal@change@protect
      \let\rebuttal@addition@listed\@secondoftwo
      \let\rebuttal@deletion@listed\@gobbletwo
      \let\rebuttal@change@listed\@thirdofthree
    }%
  \fi
}
