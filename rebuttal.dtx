% \begin{macro}{\rebuttal@triangle}
% Draws the triangle used as the default answer label.
%    \begin{macrocode}
\newcommand\rebuttal@triangle{%
  \begingroup
  \ifx\tikzexternaldisable\@undefined\else
    \tikzexternaldisable
  \fi
  \begin{tikzpicture}[x=.5em,y=.5em]
    \fill[/rebuttal/answer/triangle]
      (0,0) -- (0,1) -- (.75,.5) -- cycle;
  \end{tikzpicture}%
  \endgroup
}
%    \end{macrocode}
% \end{macro}
