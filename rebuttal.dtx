%    \begin{macrocode}
\newrobustcmd\rebuttalanswerlabel{\rebuttal@answerlabel}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\rebuttal@reference}
% Typesets the margin label of an annotation of type |#1|. The label consists
% of the uppercase initial of the type, the annotation number, and the
% references to the comments the annotation stems from.
%    \begin{macrocode}
\newrobustcmd\rebuttal@reference[1]{%
  \begingroup
  \rebuttal@referencefont
  \begin{tabular}{@{}c@{}}
    \begingroup
      \color{rebuttal@#1}%
      \MakeUppercase{\rebuttal@id}%
      \csname therebuttal#1\endcsname
    \endgroup
    \ifrebuttal@refbreak
      \\%
    \else
      \enspace
    \fi
    \normalfont
    % Reset the color. TODO Allow modifying the color.
    \color{black}%
    (\pgfkeys{/rebuttal/#1/ref/all})%
  \end{tabular}%
  \endgroup
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\rebuttal@define@keys}
% Defines the options of the annotation type |#1| whose default color is |#2|.
% The |\ref*| command without a hyperlink is available only if
% \textsf{hyperref} is loaded.
% \changes{v0.2.0}{2026-09-28}{Added \meta{inline} option}
%    \begin{macrocode}
\newcommand\rebuttal@define@keys[2]{%
  \pgfkeys{
    /rebuttal/#1/label/.initial=,
    /rebuttal/#1/label/.value required,
    /rebuttal/#1/break/.is if=rebuttal@refbreak,
    /rebuttal/#1/inline/.is if=rebuttal@inline,
    /rebuttal/#1/ref/.initial=,
    /rebuttal/#1/ref/.value required,
    /rebuttal/#1/ref/create/.code={%
      \ifx\NoHyper\@undefined
        \ref{##1}%
      \else
        \ifrebuttal@nohyperlinks
          \ref*{##1}%
        \else
          \ref{##1}%
        \fi
      \fi
    },
    /rebuttal/#1/ref/all/.code={%
      \pgfkeysgetvalue{/rebuttal/#1/ref}\rebuttal@currefs
      \edef\rebuttal@tmp{\rebuttal@currefs}%
      \foreach
      [
        count=\ri from 0,
      ]
      \r in \rebuttal@tmp {%
        \ifnum\ri > 0\relax
          ,\,%
        \fi
