\newcommand\rebuttal@replaced[2]{%
  \ifrebuttal@marked
    \rebuttal@change@font
    \textcolor{rebuttal@change@from}{\rebuttal@changefrom{#1}}%
    \allowbreak
    \textcolor{rebuttal@change}{#2}%
  \else
    #2%
  \fi
}
