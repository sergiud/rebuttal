% \begin{macro}{\rebuttal@ifannotated}
% Executes |#2| if the text |#1| contains an annotation command and |#3|
% otherwise.
%    \begin{macrocode}
\newcommand\rebuttal@ifannotated[1]{%
  \rebuttal@annotatedfalse
  \edef\reserved@a{\detokenize{#1}}%
  \rebuttal@ifcontains{\addition}%
  \rebuttal@ifcontains{\deletion}%
  \rebuttal@ifcontains{\change}%
  \ifrebuttal@annotated
    \expandafter\@firstoftwo
  \else
    \expandafter\@secondoftwo
  \fi
}
