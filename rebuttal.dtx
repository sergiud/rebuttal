\rebuttal@command{addition}{\rebuttal@added{#2}}{2}{om}{{#2}}
\rebuttal@command{deletion}{\rebuttal@deleted{#2}}{2}{om}{{#2}}
\rebuttal@command{change}{\rebuttal@replaced{#2}{#3}}{3}{omm}{{#2}{#3}}
