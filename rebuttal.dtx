% \begin{macro}{\rebuttal@savecounters}
% Saves the values of the annotation counters in |\rebuttal@restorecounters|.
%    \begin{macrocode}
\newcommand\rebuttal@savecounters{%
  \xdef\rebuttal@restorecounters{%
    \noexpand\setcounter{rebuttalchanges}{\the\c@rebuttalchanges}%
    \noexpand\setcounter{rebuttaladdition}{\the\c@rebuttaladdition}%
    \noexpand\setcounter{rebuttaldeletion}{\the\c@rebuttaldeletion}%
    \noexpand\setcounter{rebuttalchange}{\the\c@rebuttalchange}%
  }%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\rebuttal@captionpass}
% Restores the annotation counters saved by |\rebuttal@savecounters|.
%    \begin{macrocode}
\newrobustcmd\rebuttal@captionpass{\rebuttal@restorecounters}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\@makecaption}
% \changes{v0.2.0}{2026-09-28}{Number annotations in captions consistently}
% Document classes and the \textsf{caption} package typeset a caption
% repeatedly, \eg, to determine whether it fits into a single line. To number
% annotations consistently across these passes, the annotation counters are
% restored at the beginning of each pass. The last pass determines the final
% values of the counters. Captions without annotations are left untouched
% because some implementations test whether the caption text is empty.
%    \begin{macrocode}
\AfterEndPreamble{%
  \let\rebuttal@makecaption\@makecaption
  \long\def\@makecaption#1#2{%
    \rebuttal@ifannotated{#2}{%
      \rebuttal@savecounters
      \rebuttal@makecaption{#1}{\rebuttal@captionpass#2}%
    }{%
      \rebuttal@makecaption{#1}{#2}%
    }%
  }%
}
%    \end{macrocode}
% \end{macro}
