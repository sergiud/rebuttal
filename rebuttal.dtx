%
% \begin{macro}{\rebuttal@reference}
% Typesets the margin label of an annotation of type |#1|. The label consists
% of the uppercase initial of the type, the annotation number, and the
% references to the comments the annotation stems from.
%    \begin{macrocode}
\newrobustcmd\rebuttal@reference[1]{%
  \begingroup
  \rebuttal@referencefont
  \begin{tabular}{@{}c@{}}
    \begingroup
      \color{rebuttal@#1}%
      \MakeUppercase{\rebuttal@id}%
      \csname therebuttal#1\endcsname
    \endgroup
    \ifrebuttal@refbreak
      \\%
    \else
      \enspace
    \fi
    \normalfont
    % Reset the color. TODO Allow modifying the color.
    \color{black}%
    (\pgfkeys{/rebuttal/#1/ref/all})%
  \end{tabular}%
  \endgroup
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\rebuttal@define@keys}
% Defines the options of the annotation type |#1| whose default color is |#2|.
% The |\ref*| command without a hyperlink is available only if
% \textsf{hyperref} is loaded.
%    \begin{macrocode}
\newcommand\rebuttal@define@keys[2]{%
  \pgfkeys{
    /rebuttal/#1/label/.initial=,
    /rebuttal/#1/label/.value required,
    /rebuttal/#1/break/.is if=rebuttal@refbreak,
    /rebuttal/#1/ref/.initial=,
    /rebuttal/#1/ref/.value required,
    /rebuttal/#1/ref/create/.code={%
      \ifx\NoHyper\@undefined
        \ref{##1}%
      \else
        \ifrebuttal@nohyperlinks
          \ref*{##1}%
        \else
          \ref{##1}%
        \fi
      \fi
    },
    /rebuttal/#1/ref/all/.code={%
      \pgfkeysgetvalue{/rebuttal/#1/ref}\rebuttal@currefs
      \edef\rebuttal@tmp{\rebuttal@currefs}%
      \foreach
      [
        count=\ri from 0,
      ]
      \r in \rebuttal@tmp {%
        \ifnum\ri > 0\relax
          ,\,%
        \fi
        \pgfkeys{/rebuttal/#1/ref/create=\r}%
      }%
    },
    /rebuttal/#1/color/.code={\colorlet{rebuttal@#1}{##1}},
    /rebuttal/#1/color=#2,
    /rebuttal/#1/font/.value required,
    /rebuttal/#1/font/.code={%
      \expandafter\def\csname rebuttal@#1@font\endcsname{##1}%
    },
    /rebuttal/#1/font=\normalfont\mdseries,
  }%
}
%    \end{macrocode}
% \end{macro}
%
% Define the options of all annotation types.
%    \begin{macrocode}
\rebuttal@define@keys{addition}{RedViolet}
\rebuttal@define@keys{deletion}{Firebrick3}
\rebuttal@define@keys{change}{DodgerBlue3}
%    \end{macrocode}
%
%    \begin{macrocode}
\newlength\rebuttal@textwidth
\newlength\rebuttal@hskip
%    \end{macrocode}
%
% \begin{macro}{\rebuttal@command}
% Defines the annotation command |\#1| and its counter. The command takes |#3|
% arguments, the first of which is the optional list of options. |#2| typesets
% the annotated text.
%    \begin{macrocode}
\newcommand\rebuttal@command[3]{%
  \newcounter{rebuttal#1}%
  \AtEndPreamble{%
    \@ifpackageloaded{cleveref}{%
      \crefname{rebuttal#1}{#1}{#1s}%
    }{}%
  }%
%    \end{macrocode}
% Marked version with full output.
%    \begin{macrocode}
  \expandafter\newcommand\csname #1\endcsname[#3][]{%
    \ifrebuttal@marked
      \stepcounter{rebuttalchanges}%
      \refstepcounter{rebuttal#1}%
      \begingroup
        \tikzset{notestyleraw/.append style={
          inner sep=\z@,
          rounded corners=\z@,
        }}%
        \pgfqkeys{/rebuttal/#1}{##1}%
%    \end{macrocode}
% Define a label only if one was provided.
%    \begin{macrocode}
        \pgfkeysgetvalue{/rebuttal/#1/label}\rebuttal@label
        \ifx\rebuttal@label\@empty\else
          \label{\rebuttal@label}%
        \fi
        \colorlet{Changes@Color}{rebuttal@#1}%
        \begingroup
%    \end{macrocode}
% Main content.
%    \begin{macrocode}
          #2%
        \endgroup
        \edef\rebuttal@id{\@car#1\@nil}%
        \ifx\tikzexternaldisable\@undefined\else
          \tikzexternaldisable
        \fi
%    \end{macrocode}
% Shrink to text.
%    \begin{macrocode}
        \settowidth\rebuttal@textwidth{\rebuttal@reference{#1}}%
        \tikzset{notestyleraw/.append style={
          text width=\rebuttal@textwidth,
        }}%
%    \end{macrocode}
% Place labels in left margin at the same distance as on the right.
%    \begin{macrocode}
        \setlength\rebuttal@hskip{\marginparwidth}%
        \addtolength\rebuttal@hskip{-\rebuttal@textwidth}%
        \let\old@xmpar\@xmpar
%    \end{macrocode}
% Hook into the \LaTeX\ kernel command because |\if@firstcolumn| is unreliable
% for margin notes, which are floats.
%    \begin{macrocode}
        \renewcommand\@xmpar[2][]{%
          \old@xmpar[\hspace*{\rebuttal@hskip}####1]{####2}%
        }%
        \todo
        [
          backgroundcolor=none,
          bordercolor=none,
          linecolor=rebuttal@#1,
        ]{%
          \rebuttal@reference{#1}%
        }%
      \endgroup
    \else
      #2%
    \fi
  }%
}
%    \end{macrocode}
% \end{macro}
