% \begin{abstract}
% The \textsf{rebuttal} \LaTeX\ package provides markup for writing structured
% rebuttals to journal and conference paper reviews.
% \end{abstract}
%
% \section{Introduction}
%
% A well-structured rebuttal typically consists of the following parts:
%
% \begin{enumerate}
%   \item a master list of referee comments and the authors' replies, and
%   \item clearly highlighted changes to the manuscript that stem from
%   reviewers' comments.
% \end{enumerate}
%
% The \textsf{rebuttal} package provides markup that helps authors produce the
% above content consistently.
%
% \section{Usage}
%
% The following sections provide an overview of the package's functionality for
% structuring rebuttals and annotating manuscripts.
%
% \subsection{Structuring the Rebuttal}
%
% \DescribeEnv{rebuttal}
% \DescribeEnv{comment}
% \DescribeEnv{answer}
% The package defines the |rebuttal| environment, which can contain several
% blocks that refer to comments by the editor or by specific reviewers along
% with the corresponding replies. The environment accepts an optional
% \oarg{title} and is expected to contain pairs of |comment| and |answer|
% environments. The general layout is as follows:
%
% \begin{verbatim}
%   \begin{rebuttal}[Editor's Comments]
%     \begin{comment}
%       % Reviewer's comment
%     \end{comment}
%     \begin{answer}
%       % The reply
%     \end{answer}
%   \end{rebuttal}
% \end{verbatim}
%
% Comments are numbered consecutively within each |rebuttal| environment and
% prefixed by the number of the environment. An |answer| cannot be nested within
% a |comment|. The |comment| and |answer| environments are defined only within
% |rebuttal|. Therefore, they do not clash with the |comment| environment
% provided by packages such as \textsf{comment} or \textsf{verbatim}.
%
% \subsection{Annotating Changes to the Manuscript}
%
% \DescribeMacro{\addition}
% \DescribeMacro{\deletion}
% \DescribeMacro{\change}
% Within the manuscript, three commands denote additions, deletions, and
% changes:
% \begin{quote}
%   |\addition|\oarg{options}\marg{text}\\
%   |\deletion|\oarg{options}\marg{text}\\
%   |\change|\oarg{options}\marg{old text}\marg{new text}
% \end{quote}
% While |\addition| and |\deletion| expect a single argument, |\change| expects
% two arguments. The first one denotes the original text and the second one the
% new text.
%
% Each annotation is numbered and labeled in the margin. The optional
% \meta{label} option assigns a label to the annotation for referencing it, \eg,
% from within an answer. The \meta{ref} option refers back to the original
% reviewer comment and may specify multiple labels, \eg,
%
% \begin{verbatim}
%   \addition[label=a:new,ref={c:c1,c:c2}]{new text}.
% \end{verbatim}
%
% If the references do not fit into a single line in the margin, the
% \meta{break} option places them below the annotation number.
% \Cref{sec:options} lists the remaining options.
%
% \subsection{Annotating Floats, Captions, and Titles}
%
% Annotations can be used almost anywhere in a manuscript, including figures,
% tables, their captions, table cells, minipages, footnotes, and section titles.
% Margin notes are not available within floats and boxes. In such places, the
% annotation label is therefore typeset inline right after the annotated text,
% \eg,
%
% \begin{verbatim}
%   \begin{figure}
%     \centering
%     \includegraphics{result}
%     \caption{Reconstruction \addition[ref=c:c1]{of the phantom}.}
%   \end{figure}
% \end{verbatim}
%
% The \meta{inline} option places the label inline also where a margin note
% would be possible.
%
% Annotated captions and section titles are numbered only once even though they
% are typeset repeatedly. The list of figures, the table of contents, and
% running heads show the annotated text without labels. PDF bookmarks contain
% the new text only.
%
% \subsection{Annotating Multiple Paragraphs}
%
% \DescribeEnv{additionenv}
% \DescribeEnv{changeenv}
% \DescribeEnv{deletionenv}
% In addition to the markup commands, the package defines equivalent
% environments for annotating multiple paragraphs:
%
% \begin{verbatim}
%   \begin{additionenv}[label=a:par,ref=c:missing-motivations]
%     \section{New Experiment}
%     % new text
%   \end{additionenv}
%
%   \begin{changeenv}[label=ch:par,ref=c:missing-motivations]{old text}
%     \section{Improved Experiment}
%     % new text
%   \end{changeenv}
%
%   \begin{deletionenv}[label=d:par,ref=c:missing-motivations]
%     \section{Useless Discussion}
%     % old text
%   \end{deletionenv}
% \end{verbatim}
%
% \subsection{Disabling Annotations}
%
% Once a manuscript has been accepted for publication, rebuttal annotations are
% no longer necessary and only the accepted changes should be typeset.
% To this end, annotations can be disabled by setting the \meta{marked} option
% to |false| using the |\rebuttalset| command:
% \begin{verbatim}
%   \rebuttalset{marked=false}
% \end{verbatim}
% This disables annotations in the current group.
%
% \subsection{Cross-Referencing}
%
% Comments, answers, and annotations can be referenced using |\ref| and
% |\label|. If \textsf{cleveref} is loaded, the package also provides the
% corresponding names for |\cref| and |\Cref|.
%
% \DescribeMacro{\rebuttaltotalcomments}
% \DescribeMacro{\rebuttaltotalchanges}
% The total number of comments and annotations in the document is available
% through |\rebuttaltotalcomments| and |\rebuttaltotalchanges|, respectively.
% Similar to references, the values are written to the auxiliary file and
% therefore require an additional \LaTeX\ run.
%
% \subsection{Options}\label{sec:options}
%
% \DescribeMacro{\rebuttalset}
% The appearance and behavior of the package can be customized using the
% |\rebuttalset|\marg{options} command. Its argument is a comma-separated list
% of \meta{key}|=|\meta{value} pairs. Options of individual annotations can be
% additionally passed to |\addition|, |\deletion|, |\change|, and their
% environment counterparts. The following options are available:
%
% \begin{description}
%   \item[\texttt{marked}=\meta{boolean}] Enables or disables annotations.
%     Defaults to |true|.
%   \item[\texttt{no hyperlinks}=\meta{boolean}] Disables hyperlinks within
%     |rebuttal| environments and the margin references of annotations.
%     Requires \textsf{hyperref}. Defaults to |false|.
%   \item[\texttt{execute on begin}=\meta{code}] Code executed at the beginning
%     of each |rebuttal| environment.
%   \item[\texttt{execute on end}=\meta{code}] Code executed at the end of each
%     |rebuttal| environment.
%   \item[\texttt{title/font}=\meta{font}] Font of the |rebuttal| title.
%     Defaults to |\normalfont|\allowbreak|\bfseries|.
%   \item[\texttt{title/format/.code}=\marg{code}] Formats the title passed as
%     |#1|. Defaults to |#1:|.
%   \item[\texttt{comment/font}=\meta{font}] Font of comments. Defaults to
%     |\normalfont|\allowbreak|\itshape|.
%   \item[\texttt{comment/label/font}=\meta{font}] Font of the numbers of
%     comments. Defaults to
%     |\normalfont|\allowbreak|\rmfamily|\allowbreak|\bfseries|.
%   \item[\texttt{comment/bookmark}=\meta{text}] Bookmark text of comments
%     followed by the comment number. Defaults to |Comment|.
%   \item[\texttt{answer/font}=\meta{font}] Font of answers. Defaults to
%     |\normalfont|.
%   \item[\texttt{answer/label}=\meta{code}] Label placed in the left margin of
%     answers. Defaults to a gray triangle.
%   \item[\texttt{answer/label/font}=\meta{font}] Font of the answer label.
%     Defaults to |\normalfont|.
%   \item[\texttt{answer/triangle/.style}=\marg{style}] \TikZ\ style of the
%     default answer label. Defaults to |black!65|.
%   \item[\texttt{answer/bookmark}=\meta{text}] Bookmark text of answers
%     followed by the comment number. Defaults to |Answer to|.
%   \item[\texttt{answer/tooltip}=\meta{text}] Tooltip of the answer label.
%     Requires \textsf{hyperref}. Defaults to |Reply|.
%   \item[\texttt{reference/font}=\meta{font}] Font of annotation labels in the
%     margin. Defaults to |\tiny|\allowbreak|\bfseries|.
%   \item[\texttt{change/from command}=\meta{command}] Command applied to the
%     old text of a change. Defaults to |\sout|.
%   \item[\texttt{change/from color}=\meta{color}] Color of the old text of a
%     change. Defaults to |DodgerBlue3!50|.
%   \item[\texttt{deletion/command}=\meta{command}] Command applied to deleted
%     text. Defaults to |\xout|.
% \end{description}
%
% The following options apply to annotations. Passed to |\rebuttalset|, they
% need to be prefixed by |addition/|, |deletion/|, or |change/|, \eg,
% \begin{verbatim}
%   \rebuttalset{addition/color=Green}
% \end{verbatim}
%
% \begin{description}
%   \item[\texttt{label}=\meta{label}] Label of the annotation.
%   \item[\texttt{ref}=\meta{labels}] Comma-separated labels of the comments
%     the annotation stems from.
%   \item[\texttt{break}] Places the references in the margin below the
%     annotation number.
%   \item[\texttt{inline}] Places the label right after the annotated text
%     instead of the margin.
%   \item[\texttt{color}=\meta{color}] Color of the annotation. Defaults to
%     |RedViolet| for additions, |Firebrick3| for deletions, and |DodgerBlue3|
%     for changes.
%   \item[\texttt{font}=\meta{font}] Font of the annotated text. Defaults to
%     |\normalfont|\allowbreak|\mdseries|.
% \end{description}
%
% \DescribeMacro{\rebuttalanswerlabel}
% The current answer label can be typeset using |\rebuttalanswerlabel|, \eg, to
% explain the markup in the introduction of the rebuttal letter.
%
% \section{Known Limitations}
%
% Annotations are recognized in captions only if |\addition|, |\deletion|, or
% |\change| appear literally in the caption text rather than within the
% definition of another command. Otherwise, an annotated caption that is
% typeset repeatedly may be counted more than once.
%
% The optional arguments of annotations are discarded in lists, running heads,
% and PDF bookmarks. Annotations there are therefore typeset using the global
% colors and fonts.
%
% Within captions and titles, the |additionenv|, |changeenv|, and |deletionenv|
% environments are annotated again in lists such as the list of figures. Use the
% corresponding commands instead.
%
% \MaybeStop{\PrintChanges\PrintIndex}
%
% \section{Implementation}
%
