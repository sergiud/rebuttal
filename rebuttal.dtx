% \begin{macro}{\rebuttal@defprotect}
% Defines the expandable command |#1| with the argument specification |#3|,
% which expands to the robust command |#2| followed by empty options and the
% arguments |#4|.
%    \begin{macrocode}
\newcommand\rebuttal@defprotect[4]{%
  \NewExpandableDocumentCommand#1{#3}{\protect#2{}#4}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\rebuttal@command}
% \changes{v0.2.0}{2026-09-28}{Support annotations in captions and lists}
% Defines the annotation command |\#1| and its counter. The command takes |#3|
% arguments, the first of which is the optional list of options. |#2| typesets
% the annotated text.
%    \begin{macrocode}
\newcommand\rebuttal@command[5]{%
  \newcounter{rebuttal#1}%
  \AtEndPreamble{%
    \@ifpackageloaded{cleveref}{%
      \crefname{rebuttal#1}{#1}{#1s}%
    }{}%
  }%
%    \end{macrocode}
% The annotation command is robust. While typesetting, it annotates the text.
% When written to a file or a mark, \eg, as part of a caption to the list of
% figures or a section title to the running head, it is replaced by a variant
% that typesets the annotated text only. Otherwise, each entry in the list would
% be numbered and labeled again. |#4| is the argument specification of the
% command and |#5| the arguments passed to the replacement, which discards the
% options. This way, the options are exposed neither to case changes in running
% heads nor to PDF strings.
%    \begin{macrocode}
  \expandafter\edef\csname #1\endcsname{%
    \noexpand\ifx\noexpand\protect\noexpand\@typeset@protect
      \noexpand\expandafter
      \expandafter\noexpand\csname rebuttal@#1@typeset\endcsname
    \noexpand\else
      \noexpand\expandafter
      \expandafter\noexpand\csname rebuttal@#1@protect\endcsname
    \noexpand\fi
  }%
  \expandafter\rebuttal@defprotect
    \csname rebuttal@#1@protect\expandafter\endcsname
    \csname rebuttal@#1@listed\endcsname{#4}{#5}%
  \expandafter\newcommand\csname rebuttal@#1@listed\endcsname[#3]{%
    \begingroup
      #2%
    \endgroup
  }%
%    \end{macrocode}
% Marked version with full output.
%    \begin{macrocode}
  \expandafter\newcommand\csname rebuttal@#1@typeset\endcsname[#3][]{%
    \ifrebuttal@marked
      \stepcounter{rebuttalchanges}%
      \begingroup
%    \end{macrocode}
% \changes{v0.2.0}{2026-09-28}{Do not redirect subsequent labels to
% annotations}
% The annotation must not become the target of subsequent labels, \eg, of a
% |\label| following an annotated |\caption|. Therefore, the counter is
% incremented within a group. Since \textsf{hyperref} sets the link target
% globally, the previous target is restored after the label of the annotation
% has been defined.
%    \begin{macrocode}
        \let\rebuttal@currentHref\@currentHref
        \refstepcounter{rebuttal#1}%
        \tikzset{notestyleraw/.append style={
          inner sep=\z@,
          rounded corners=\z@,
        }}%
        \pgfqkeys{/rebuttal/#1}{##1}%
%    \end{macrocode}
% Define a label only if one was provided.
%    \begin{macrocode}
        \pgfkeysgetvalue{/rebuttal/#1/label}\rebuttal@label
        \ifx\rebuttal@label\@empty\else
          \label{\rebuttal@label}%
        \fi
        \ifx\rebuttal@currentHref\@undefined\else
          \global\let\@currentHref\rebuttal@currentHref
        \fi
        \colorlet{Changes@Color}{rebuttal@#1}%
        \begingroup
%    \end{macrocode}
% Main content.
%    \begin{macrocode}
          #2%
        \endgroup
        \edef\rebuttal@id{\@car#1\@nil}%
        \ifx\tikzexternaldisable\@undefined\else
          \tikzexternaldisable
        \fi
        \rebuttal@ifmarginavailable{%
          \rebuttal@marginreference{#1}%
        }{%
          \rebuttal@inlinereference{#1}%
        }%
      \endgroup
    \else
      #2%
    \fi
  }%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\rebuttal@inlinereference}
% Places the label of an annotation of type |#1| inline right after the
% annotated text.
%    \begin{macrocode}
\newcommand\rebuttal@inlinereference[1]{%
  \leavevmode
  \nobreak
  \hspace{\rebuttal@inlinesep}%
  \rebuttal@reference{#1}%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\rebuttal@marginreference}
% Places the label of an annotation of type |#1| in the margin.
%    \begin{macrocode}
\newcommand\rebuttal@marginreference[1]{%
%    \end{macrocode}
% Shrink to text.
%    \begin{macrocode}
  \settowidth\rebuttal@textwidth{\rebuttal@reference{#1}}%
  \tikzset{notestyleraw/.append style={
    text width=\rebuttal@textwidth,
  }}%
%    \end{macrocode}
% Place labels in left margin at the same distance as on the right.
%    \begin{macrocode}
  \setlength\rebuttal@hskip{\marginparwidth}%
  \addtolength\rebuttal@hskip{-\rebuttal@textwidth}%
  \let\old@xmpar\@xmpar
%    \end{macrocode}
% Hook into the \LaTeX\ kernel command because |\if@firstcolumn| is unreliable
% for margin notes, which are floats.
%    \begin{macrocode}
  \renewcommand\@xmpar[2][]{%
    \old@xmpar[\hspace*{\rebuttal@hskip}##1]{##2}%
  }%
  \todo
  [
    backgroundcolor=none,
    bordercolor=none,
    linecolor=rebuttal@#1,
  ]{%
    \rebuttal@reference{#1}%
  }%
}
%    \end{macrocode}
% \end{macro}
