% \begin{macro}{\rebuttal@ifmarginavailable}
% \changes{v0.2.0}{2026-09-28}{Place annotation labels inline where margin
% notes are not available}
% Executes |#1| if the annotation label can be placed in the margin and |#2|
% otherwise. Margin notes are not available in inner mode, within floats, and
% within boxes such as minipages, parboxes, and footnotes. Since \LaTeX\ resets
% the paragraph parameters in all such boxes, the \texttt{boxed} switch is set
% whenever this happens.
%    \begin{macrocode}
\newcommand\rebuttal@ifmarginavailable[2]{%
  \rebuttal@margintrue
  \ifinner
    \rebuttal@marginfalse
  \fi
  \ifrebuttal@boxed
    \rebuttal@marginfalse
  \fi
  \ifx\@captype\@undefined\else
    \rebuttal@marginfalse
  \fi
  \ifrebuttal@inline
    \rebuttal@marginfalse
  \fi
  \ifrebuttal@margin
    #1%
  \else
    #2%
  \fi
}
\AfterEndPreamble{%
  \appto\@arrayparboxrestore{\rebuttal@boxedtrue}%
  \appto\@parboxrestore{\rebuttal@boxedtrue}%
}
%    \end{macrocode}
% \end{macro}
