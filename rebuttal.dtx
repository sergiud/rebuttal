\newcommand\rebuttal@ifcontains[1]{%
  \edef\reserved@b{\noexpand\in@{\detokenize{#1}}{\reserved@a}}%
  \reserved@b
  \ifin@
    \rebuttal@annotatedtrue
  \fi
}
