% \begin{macro}{\rebuttal@replaced}
% Typeset added, deleted, and replaced text. Deleted text is omitted if
% annotations are disabled.
%    \begin{macrocode}
\newcommand\rebuttal@added[1]{%
  \ifrebuttal@marked
    \rebuttal@addition@font
    \textcolor{rebuttal@addition}{#1}%
  \else
