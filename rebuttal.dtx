% \begin{macro}{\rebuttal@startlinkguard}
% Disables hyperlinks if the \meta{no hyperlinks} option is set and the
% |NoHyper| environment is available.
%    \begin{macrocode}
\newcommand\rebuttal@startlinkguard{%
  \ifx\NoHyper\@undefined\else
    \ifrebuttal@nohyperlinks
      \begin{NoHyper}%
    \fi
  \fi
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\rebuttal@endlinkguard}
% Re-enables hyperlinks disabled by |\rebuttal@startlinkguard|.
%    \begin{macrocode}
\newcommand\rebuttal@endlinkguard{%
  \ifx\endNoHyper\@undefined\else
    \ifrebuttal@nohyperlinks
      \end{NoHyper}%
    \fi
  \fi
}
%    \end{macrocode}
% \end{macro}
%
% \begin{environment}{rebuttal}
% The main environment, which defines the remaining ones.
% \changes{v0.1.1}{2024-11-14}{Fixed incorrect bookmark structure}
%    \begin{macrocode}
\newenvironment{rebuttal}[1][]{%
  \rebuttal@startlinkguard
%    \end{macrocode}
% Execute user code.
%    \begin{macrocode}
  \pgfkeysvalueof{/rebuttal/execute on begin}%
  \begingroup
  \refstepcounter{rebuttal}%
  \if@twocolumn
    \onecolumn
%    \end{macrocode}
% Remember the layout.
%    \begin{macrocode}
    \rebuttal@twocolumntrue
  \else
    \rebuttal@twocolumnfalse
  \fi
  \begingroup
  \par
  \addvspace{\bigskipamount}%
  \ifstrempty{#1}{}{%
%    \end{macrocode}
% If the current bookmark level is 0, leave it as is. Otherwise, increment the
% level to anchor the following bookmarks below the current bookmark. This keeps
% the bookmark structure correct even if the document neither provides nor uses
% structuring commands, \eg, a \textsf{scrlttr2} document without |\section|.
%    \begin{macrocode}
    \ifx\Hy@currentbookmarklevel\@undefined\else
      \ifnum\Hy@currentbookmarklevel>0
        \rebuttal@incbookmarklevel
      \fi
    \fi
    \ifx\currentpdfbookmark\@undefined\else
      \currentpdfbookmark{#1}{rebuttalcomment.\therebuttalcomment}%
    \fi
    \noindent\bgroup\rebuttal@titlefont\strut
    \pgfkeys{/rebuttal/title/format=#1}\egroup
  }%
  \par
  \@afterheading
  \vspace*{\medskipamount}%
  \begin{trivlist}%
  \let\rebuttal@oldmakelabel\makelabel
  \renewcommand\makelabel[1]{\llap{\rebuttal@commentlabelfont ##1}}%
  \labelwidth\z@
  \let\comment\@undefined
  \let\endcomment\@undefined
  \newenvironment{comment}{%
    \rebuttal@incbookmarklevel
    \apptocmd\@item{%
      \ifx\currentpdfbookmark\@undefined\else
        \currentpdfbookmark
          {\rebuttal@commentbookmark~\therebuttalcomment}%
          {rebuttalcomment.\therebuttalcomment}%
      \fi
    }{%
      \PackageInfo{rebuttal}{The \string\@item\space command was
        patched to provide comment bookmarks.}%
    }{%
      \PackageWarning{rebuttal}{Failed to patch the \string\@item\space
        command. Bookmarks may not be displayed correctly.}%
    }%
%    \end{macrocode}
% Prevent answers from being placed within a comment by undefining the |answer|
% environment.
%    \begin{macrocode}
    \let\answer\@undefined
    \let\endanswer\@undefined
    \stepcounter{rebuttalcomments}%
    \refstepcounter{rebuttalcomment}%
    % TODO Add tooltips to comment labels.
    \item
    [%
      \therebuttalcomment
    ]%
    \begingroup
    \rebuttal@commentfont
    \let\makelabel\rebuttal@oldmakelabel
  }{%
    \endgroup
    \rebuttal@decbookmarklevel
  }%
%    \end{macrocode}
% \changes{v0.2.0}{2026-09-28}{Fixed \meta{answer/label/font} option being
% ignored}
% The label of an answer is placed in the left margin. Therefore, the label
% separation is removed while the label is typeset and restored afterwards.
%    \begin{macrocode}
  \newenvironment{answer}{%
    \par\medskip
    \@afterheading
    \rebuttal@incbookmarklevel
    \begin{trivlist}%
      \ifx\belowpdfbookmark\@undefined\else
        \belowpdfbookmark{\rebuttal@answerbookmark~\therebuttalcomment}%
          {rebuttalanswer.\therebuttalanswer}%
      \fi
      \normalfont\rebuttal@answerfont
      \rebuttal@labelsep\labelsep
      \labelsep\z@
      \labelwidth\z@
      \let\makelabel\@firstofone
      \item
        [%
          \ifx\pdftooltip\@undefined
            \llap{%
              \rebuttal@answerlabelfont\rebuttal@answerlabel\enspace
            }%
          \else
            \llap{%
              \pdftooltip
                {\rebuttal@answerlabelfont\rebuttal@answerlabel}%
                {\rebuttal@answertooltip}%
              \enspace
            }%
          \fi
        ]%
        \begingroup
        \labelsep\rebuttal@labelsep
        \refstepcounter{rebuttalanswer}%
  }{%
    \endgroup
    \end{trivlist}%
    \rebuttal@decbookmarklevel
  }%
}{%
  \end{trivlist}%
  \rebuttal@decbookmarklevel
  \endgroup
  \par\addvspace{\bigskipamount}%
  \ifrebuttal@twocolumn
%    \end{macrocode}
% Restore the layout.
%    \begin{macrocode}
    \twocolumn
  \fi
  \endgroup
%    \end{macrocode}
% Execute user code.
%    \begin{macrocode}
  \pgfkeysvalueof{/rebuttal/execute on end}%
  \rebuttal@endlinkguard
}
%    \end{macrocode}
